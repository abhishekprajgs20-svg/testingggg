{
  "name": "quizinox-desktop-and-android",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:init": "cap add android",
    "android:sync": "cap sync android",
    "android:icons": "python3 scripts/generate_android_icons.py",
    "desktop:dev": "vite --host 127.0.0.1",
    "desktop:run": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --win nsis --publish never",
    "desktop:portable": "npm run build && electron-builder --win portable --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/share": "^7.0.2",
    "jspdf": "^3.0.3",
    "pdfjs-dist": "^5.4.394"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "vite": "^6.4.1",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "description": "QUIZINOX offline-first quiz maker and player for Android and Windows",
  "author": "QUIZINOX",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.quizinox.desktop",
    "productName": "QUIZINOX",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "QUIZINOX-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QUIZINOX",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "QUIZINOX-Portable-${version}.${ext}"
    }
  }
}
